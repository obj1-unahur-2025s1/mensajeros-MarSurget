import mensajeria.*
import tiposPaquetes.*
import mensajeros.*


  test "Roberto puede entregar paquete pagado en camión con un acoplado por el Puente de Brooklyn" {
    roberto.usarTransporte(camion)
    paquete.pagar()
    paquete.destino(puenteDeBrooklyn)
    assert.that(paquete.puedeSerEntregado(roberto))
  }

  test "Neo con crédito no puede entregar paquete no pagado en la Matrix" {
    neo.cargarCredito(10)
    paquete.estaPago()
    paquete.destino(matrix)
    assert.that(!paquete.puedeSerEntregado(neo))   // ! "negación lógica".
  }


  test "Despedir a todos" {
    mensajeria.despedirATodos()
    assert.that(mensajeria.cantidadMensajeros() == 0)
  }

  test "Mensajeria puede contratar un mensajero" {
    mensajeria.despedirATodos()
    mensajeria.contratar(roberto)
    assert.that(mensajeria.cantidadMensajeros() == 1)
  }

  test "Mensajeria puede despedir a un mensajero" { 
    mensajeria.contratar(roberto)
    mensajeria.contratar(neo)
    mensajeria.contratar(chuckNorris)            
    mensajeria.despedir(roberto)
    assert.that(mensajeria.cantidadMensajeros() == 2)    
  }


test "Consulta si la mensajeria es grande osea tiene mas de dos mensajeros" {
    mensajeria.despedirATodos()
    // roberto.usarTransporte(camion) /// LE TENGO QUE PONER EL TRANSPORTE PARA QUE SE INICIALICE ROBERTO?
    mensajeria.contratar(roberto)
    mensajeria.contratar(neo)
    mensajeria.contratar(chuckNorris)

    assert.that(mensajeria.esGrande()) 
}


  test "Mensajeria entrega rapido el paquete" { 
    paquete.pagar()
    paquete.destino(puenteDeBrooklyn)
    mensajeria.despedirATodos()
    mensajeria.contratar(chuckNorris)
    assert.that(mensajeria.entregaRapida())
  }

  test "Peso final devuelve el peso del último mensajero" {
    mensajeria.despedirATodos()
    mensajeria.contratar(roberto)
    roberto.usarTransporte(camion) // 90 + 500
    assert.that(mensajeria.pesoFinal() == 590)
  }



 test "paquetito siempre se puede entregar" {
  mensajeria.despedirATodos()
  mensajeria.contratar(chuckNorris)
  mensajeria.contratar(neo)
  mensajeria.contratar(roberto)
  roberto.usarTransporte(bicicleta)

  assert.that(mensajeria.puedeEntregar(paquetito))
}
test "paqueton no puede ser entregado sin pagar" {
  mensajeria.despedirATodos()
  mensajeria.contratar(chuckNorris)
  mensajeria.contratar(neo)
  mensajeria.contratar(roberto)
  roberto.usarTransporte(bicicleta)
  assert.that(!mensajeria.puedeEntregar(paqueton))
}

test "paqueton puede ser entregado si está pagado y Chuck pasa por todos los destinos" {
    paqueton.pagar(300)
    assert.that(paqueton.estaPago())
    assert.that(chuckNorris.puedeViajar(puenteDeBrooklyn))
    assert.that(chuckNorris.puedeLlamar())
    assert.that(paqueton.puedeSerEntregado(chuckNorris))

}

test "quienes pueden entregar el paquetito" {
  mensajeria.despedirATodos()
  mensajeria.contratar(chuckNorris)
  mensajeria.contratar(neo)
  mensajeria.contratar(roberto)

  assert.that(mensajeria.quienesPuedeEntregar(paquetito).size() == 3)
  // assert.that(mensajeria.quienesPuedeEntregar(paquetito).size() == 3) otra opcion
}  

  test "mensajería tiene sobrepeso si promedio > 500" {
    mensajeria.despedirATodos()
    mensajeria.contratar(chuckNorris)
    mensajeria.contratar(neo)
    mensajeria.contratar(roberto)

    roberto.usarTransporte(camion) // 90 + 500 = 590
    mensajeria.despedir(neo)
    mensajeria.despedir(chuckNorris)
    assert.that(mensajeria.tieneSobrepeso())
  
  }

test "enviar un paquete exitosamente" {
  mensajeria.despedirATodos()
  mensajeria.contratar(roberto)

  paquetito.destino(puenteDeBrooklyn)
  mensajeria.enviar(paquetito)

  assert.that(mensajeria.listaEnviados().any { p => p.precio() == 0 })
}
test "enviar un paquete no entregable, entonces lo deja en pendientes" {
  mensajeria.despedirATodos()
  mensajeria.enviar(paqueton) 
  assert.that(mensajeria.listaPendientes().any { p => p  == paqueton })
}

  test "facturación de mensajería de paquetito" {
    paquetito.destino(puenteDeBrooklyn)
    mensajeria.enviar(paquetito)
    assert.that(mensajeria.facturacion() == 0)
  }

test "facturación de mensajería de paqueton" {
    mensajeria.despedirATodos()
    mensajeria.contratar(chuckNorris) 
    paqueton.pagar(300) // pago de mas pero no importa,porq lo que importa esq esta pago
    mensajeria.enviar(paqueton)
    assert.that(mensajeria.facturacion() == 200)
  }
test "enviar todos los paquetes" {
  mensajeria.despedirATodos()
  mensajeria.contratar(chuckNorris) 


  paquetito.destino(puenteDeBrooklyn)
  paqueton.pagar(300)
  paquetin.pagar(100)
  mensajeria.enviarTodos([paquetito, paqueton, paquetin])   
  assert.that(mensajeria.listaEnviados().size() == 3) 
}

test "reenviar paquete mas caro" {
  mensajeria.despedirATodos()
  paqueton.pagar(300)
  mensajeria.enviar(paqueton)
  assert.that(mensajeria.listaPendientes().any { p => p == paqueton }) // No hay mensajeros, queda en pendientes
 
  mensajeria.contratar(chuckNorris) // Contratamos a alguien 
  mensajeria.reenviarPendienteCaro() 
  assert.that(not mensajeria.listaPendientes().any { p => p == paqueton })// Verificamos que ya no este en pendientes
  assert.that(mensajeria.listaEnviados().any { p => p == paqueton }) // Verificamos que esté en enviados
}
test "Carlos puede entregar paquetin pagado en bicicleta por Matrix" {
    mensajeria.despedirATodos()
    mensajeria.contratar(carlos)
    carlos.usarTransporte()
    paquetin.pagar(100)
    assert.that(paquetin.puedeSerEntregado(carlos))
  }

test "Carlos no puede entregar paquetin porque no esta todo pago en bicicleta por Matrix" {
    mensajeria.despedirATodos()
    mensajeria.contratar(carlos)
    carlos.usarTransporte()
    paquetin.pagar(10)
    assert.notThat(paquetin.puedeSerEntregado(carlos))
  }
